<?xml version="1.0" encoding="UTF-8"?>
<exchange xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://download.autodesk.com/us/navisworks/schemas/nw-exchange-12.0.xsd" units="ft" filename="" filepath="">
  <batchtest name="Mini" internal_name="Mini" units="ft">
    <clashtests>
      <clashtest name="T1_A-Doors vs S-Walls" test_type="hard" status="new" tolerance="0.0820209974" merge_composites="1" priority="0">
        <default_assignee display_name=""/>
        <linkage mode="none"/>
        <left><clashselection selfintersect="0" primtypes="1"><locator>lcop_selection_set_tree/A-Architecture/A-Doors</locator></clashselection></left>
        <right><clashselection selfintersect="0" primtypes="1"><locator>lcop_selection_set_tree/S-Structure/S-Walls</locator></clashselection></right>
        <rules/>
      </clashtest>
    </clashtests>
    <selectionsets>
      <viewfolder name="A-Architecture" guid="11111111-1111-4111-8111-111111111111">
        <selectionset name="A-Doors" guid="22222222-2222-4222-8222-222222222222">
          <findspec mode="all" disjoint="0"><conditions>
            <condition test="equals" flags="400"><category><name internal="LcRevitData_Element">Element</name></category><property><name internal="LcRevitData_Element:LcRevitPropertyElementCategory">Category</name></property><value><data type="wstring">Doors</data></value></condition>
          </conditions><locator>/</locator></findspec>
        </selectionset>
      </viewfolder>
      <viewfolder name="S-Structure" guid="33333333-3333-4333-8333-333333333333">
        <selectionset name="S-Walls" guid="44444444-4444-4444-8444-444444444444">
          <findspec mode="all" disjoint="0"><conditions>
            <condition test="equals" flags="400"><category><name internal="LcRevitData_Element">Element</name></category><property><name internal="LcRevitData_Element:LcRevitPropertyElementCategory">Category</name></property><value><data type="wstring">Walls</data></value></condition>
            <condition test="contains" flags="400"><category><name internal="LcSvf_Document">File</name></category><property><name internal="Title">Name</name></property><value><data type="wstring">STR</data></value></condition>
            <condition test="equals" flags="464"><category><name internal="LcRevitData_Element">Element</name></category><property><name internal="LcRevitData_Element:LcRevitPropertyElementCategory">Category</name></property><value><data type="wstring">Floors</data></value></condition>
            <condition test="greater_equal" flags="400"><category><name internal="LcRevitData_Element">Element</name></category><property><name internal="lcldrevit_parameter_-1001301">Width</name></property><value><data type="linear">0.196850</data></value></condition>
            <condition test="no_prop" flags="0"><category><name internal="LcRevitData_Element">Element</name></category><property><name internal="Comments">Comments</name></property><value><data/></value></condition>
          </conditions><locator>/</locator></findspec>
        </selectionset>
      </viewfolder>
    </selectionsets>
  </batchtest>
</exchange>
